{
  "name": "arbiter",
  "version": "0.5.0",
  "description": "Headless core (library + CLI) for the Arbiter three-tier agentic knowledge base",
  "type": "module",
  "private": true,
  "bin": {
    "arbiter": "./bin/arbiter.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit && node --import tsx --test test/*.test.ts",
    "arbiter": "node --import tsx src/cli/main.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
